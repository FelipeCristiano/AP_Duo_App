{
  "name": "ap_duo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "electron:dev": "concurrently \"expo start --web\" \"wait-on http://localhost:8081 && electron main.js\"",
    "electron:build": "expo export -p web && electron-builder --win"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.8",
    "expo-document-picker": "~55.0.9",
    "expo-file-system": "~55.0.11",
    "expo-font": "~55.0.4",
    "expo-image-picker": "~55.0.13",
    "expo-print": "~55.0.9",
    "expo-router": "~55.0.7",
    "expo-sharing": "~55.0.14",
    "expo-splash-screen": "~55.0.12",
    "expo-sqlite": "~55.0.11",
    "expo-status-bar": "~55.0.4",
    "express": "^5.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-paper": "^5.15.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "~5.9.2",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.apduo.app",
    "productName": "APduo",
    "asar": false,
    "extraMetadata": {
      "main": "main.js"
    },
    "directories": {
      "output": "release",
      "app": "."
    },
    "files": [
      "dist/**/*",
      "icon.ico",
      "installer-sidebar.bmp",
      "main.js",
      "preload.js",
      "package.json",
      "!node_modules/**",
      "!site_APduo/**",
      "!**/*.map",
      "!**/*.ts",
      "!.expo/**",
      "!app/**",
      "!assets/**",
      "!services/**",
      "!stores/**",
      "!constants/**"
    ],
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "APduo",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "installerSidebar": "installer-sidebar.bmp",
      "uninstallerSidebar": "installer-sidebar.bmp",
      "language": "1046",
      "artifactName": "APduo-Setup-${version}.exe"
    }
  },
  "private": true
}